# ──────────────────────────────────────────────────────────────────────
# REQUIRED — the agent will not start without these
# ──────────────────────────────────────────────────────────────────────

# LiveKit Cloud credentials
# Get from: https://cloud.livekit.io → Project Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# OpenAI API key (used for LLM — GPT-4.1-mini)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Deepgram API key (used for STT and TTS — Aura 2)
# Get from: https://console.deepgram.com/
DEEPGRAM_API_KEY=...

# OpenClaw gateway connection
# URL: port 19001 for dev mode, 18789 for prod. Use ws:// local, wss:// remote
# Token: must match the token in your OpenClaw gateway config
#   → check ~/.openclaw/openclaw.json → gateway.auth.token
#   → or the OPENCLAW_GATEWAY_TOKEN env var in ~/.openclaw/.env
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:19001
OPENCLAW_GATEWAY_TOKEN=your-gateway-token

# ──────────────────────────────────────────────────────────────────────
# OPTIONAL — uncomment to enable or override
# ──────────────────────────────────────────────────────────────────────

# Default Telegram recipient (your numeric Telegram user ID)
# Get it by typing /whoami to your bot after pressing Start
# DEFAULT_TELEGRAM_RECIPIENT=123456789

# ElevenLabs API key (alternative TTS provider)
# ELEVENLABS_API_KEY=...

# Override default STT/LLM/TTS models
# LIVEKIT_STT=deepgram/nova-3:multi
# LIVEKIT_LLM=openai/gpt-4.1-mini
# LIVEKIT_TTS=openai/tts-1:nova
